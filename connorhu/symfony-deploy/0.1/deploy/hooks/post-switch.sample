#!/usr/bin/env bash
# Hook: post-switch (célgépen, a symlink cseréje után).
# Bekapcsolás: nevezd át, hogy a .sample végződés elmaradjon, és commitold a repóba.
# A hook `bash -e` módban fut, az első hibás parancs leállítja a deploy-t.
# Munkamappa: a release mappa
# Titkot ne tegyél ide, a hook a repó része.
#
# Környezeti változók:
#   DEPLOY_ENV       a környezet neve (pl. prod)
#   RELEASE_DIR      a release mappa
#   RELEASE_HASH     a telepített commit hash-e
#   SHARED_DIR       a megosztott mappák helye a célgépen
#   CREDENTIALS_DIR  a célgépi credential fájlok mappája
#   PROJECT_ROOT     a projekt gyökere a célgépen
#   DEPLOY_OWNER     a release tulajdonosa a célgépen

# Példa: php-fpm újratöltése.
# systemctl reload php8.4-fpm
echo "post-switch: $DEPLOY_ENV @ $RELEASE_HASH"
